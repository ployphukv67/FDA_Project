  "cards": [
    {
      "dot": "emerald",
      "title": "Main prediction path",
      "items": [
        "Sector-level target: P(sector falls ≥40% within 6/12/24 months), per Greenwood, Shleifer & You (2019)",
        "Logit is the main model; Random Forest and Logit+Macro are comparisons",
        "Sector probabilities roll back up into a cap-weighted S&P 500 bubble breadth"
      ]
    },
    {
      "dot": "violet",
      "title": "Detection layers stay separate",
      "items": [
        "GSADF and HMM are regime / detection layers, not classifier inputs",
        "HMM picks 2 vs 3 states by BIC and is checked against NBER recessions; VIX is a robustness test",
        "HMM filtered regime probabilities are used for charts and context in the evaluation and breadth sections"
      ]
    },
    {
      "dot": "rose",
      "title": "Leakage controls",
      "items": [
        "Expanding-window refit every year from 1960, train starting 1931",
        "Purge: only labels resolved by the prior year end enter training",
        "Already-crashed months (≥20% below 12-month peak) are masked"
      ]
    }
  ]
